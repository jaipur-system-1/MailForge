# Set to true in UAT and false for local development.
MAILFORGE_UAT=true

# Generate a unique secret for UAT. Never commit the real value.
DJANGO_SECRET_KEY=replace-with-a-long-random-uat-secret
DJANGO_DEBUG=false

# Hostnames only: do not include http://, https://, or a path.
DJANGO_ALLOWED_HOSTS=mailforge.dev.acuvisor.com,localhost,127.0.0.1

# Origins must include https:// and must not end with a slash.
DJANGO_CORS_ALLOWED_ORIGINS=https://mailforge.dev.acuvisor.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://mailforge.dev.acuvisor.com

# The reverse proxy routes /api and related Django paths to the backend.
DJANGO_API_URL=https://mailforge.dev.acuvisor.com
DJANGO_API_TIMEOUT_SECONDS=10
DJANGO_LOGIN_THROTTLE_RATE=30/minute

# Use an absolute path on persistent UAT storage in a real deployment.
DJANGO_DATABASE_PATH=django_backend/db.sqlite3
DJANGO_DB_CONN_MAX_AGE=60

# HTTPS security. Keep these true in UAT.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true

# UAT uses a trusted reverse proxy that sets X-Forwarded-Proto.
DJANGO_TRUST_PROXY_HEADERS=true

# One hour is a cautious initial UAT value. Set 0 only while diagnosing HTTPS.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

